# Copia este archivo a .env (o .env.local) y completa los valores. .env está en .gitignore.

# Configuración de Firebase (consola de Firebase > Configuración del proyecto > Tus apps)
NEXT_PUBLIC_apiKey=
NEXT_PUBLIC_authDomain=
NEXT_PUBLIC_projectId=
NEXT_PUBLIC_storageBucket=
NEXT_PUBLIC_messagingSenderId=
NEXT_PUBLIC_appId=
NEXT_PUBLIC_measurementId=

# Usuario invitado (botón "Ingresar como invitado"). Si no se definen, el botón no aparece.
# OJO: las variables NEXT_PUBLIC_* quedan visibles en el navegador. Trata a este usuario como PÚBLICO:
# debe ser solo lectura (ver firestore.rules) y conviene cambiar su contraseña, porque la anterior
# estuvo escrita en el código y sigue en el historial de git.
NEXT_PUBLIC_GUEST_EMAIL=
NEXT_PUBLIC_GUEST_PASSWORD=
